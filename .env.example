# Local development. For production set production and use the settings below:
# SERVER_ADDRESS=127.0.0.1:8081
# PUBLIC_BASE_URL=https://socket.example.com
# FRONTEND_ORIGINS=lab.example.com
TRANSPORT_MODE=development

# WebSocket/HTTP server listen address.
# Use :8081 to listen on every interface, or 127.0.0.1:8081 when a local
# reverse proxy (Caddy/Nginx) is the only process that should reach Go directly.
SERVER_ADDRESS=:8081

# Required PostgreSQL connection string. Use the same database/schema as REST.
# Review the existing schema and already-applied migrations before deployment.
# Set a real value in your local ignored .env or process environment:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable
DATABASE_URL=
# lib/pq DSN format is also accepted:
# DATABASE_URL=user=postgres password=change-me host=localhost port=5432 dbname=ratsystem sslmode=disable

# Comma-separated WebSocket OriginPatterns allowed for /ws/frontend.
# Values are host patterns without http:// or https://.
FRONTEND_ORIGINS=localhost:3000,127.0.0.1:3000
# Production example:
# FRONTEND_ORIGINS=admin.example.com

# Public URL that Agents can reach. It is used as the prefix of temporary
# download URLs. Production Agents require HTTPS. Do not use localhost when
# Agents run on another machine.
PUBLIC_BASE_URL=https://localhost:8443
# LAN example:
# PUBLIC_BASE_URL=https://192.168.1.10:8443
# Production example:
# PUBLIC_BASE_URL=https://agent-api.example.com

# Absolute directory containing every file referenced by files.storage_path.
# A download is rejected with HTTP 403 if its resolved storage_path is outside
# this directory. Prefer an absolute path to avoid working-directory ambiguity.
FILE_STORAGE_ROOT=./storage
# Linux example:
# FILE_STORAGE_ROOT=/var/lib/ws-rat/files

# Lifetime, in seconds, of each per-Agent opaque download URL.
DOWNLOAD_URL_TTL_SECONDS=600

# Frontend (Next.js) variable; configure this in the frontend application's
# own .env.local rather than the Go server environment.
# Browser authentication uses the Secure, HttpOnly cookie __Host-session.
# NEXT_PUBLIC_FRONTEND_WS_URL=wss://lab.example.com/ws/frontend
# This hostname must match the Dashboard for the host-only session cookie.
